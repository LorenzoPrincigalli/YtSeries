{
  "name": "yt-series",
  "version": "1.2.0",
  "private": true,
  "description": "Transform YouTube playlists into a TV-series tracker with cinematic UI",
  "license": "MIT",
  "author": "LorenzoPrincigalli",
  "repository": {
    "type": "git",
    "url": "https://github.com/LorenzoPrincigalli/YtSeries.git"
  },
  "bugs": {
    "url": "https://github.com/LorenzoPrincigalli/YtSeries/issues"
  },
  "homepage": "https://github.com/LorenzoPrincigalli/YtSeries",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "icons": "node src/assets/scripts/generate-icons.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && node scripts/lint-css.mjs",
    "trailer": "node scripts/generate-trailer.cjs",
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke && npm run e2e",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "package": "node scripts/package.mjs",
    "screenshots": "node scripts/store-screenshots.mjs",
    "promo": "node scripts/store-promo.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/chrome": "^0.1.12",
    "axe-core": "^4.10.3",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.7"
  }
}
