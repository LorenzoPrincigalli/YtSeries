{
  "manifest_version": 3,
  "name": "YT Series",
  "version": "1.3.0",
  "key": "",
  "description": "Transform YouTube playlists into a TV-series tracker with a cinematic interface",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "identity",
    "scripting"
  ],
  "oauth2": {
    "client_id": "1052836687022-2rebg9qq23n14m4reqt5hv7ckfbd64tn.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://shy-snowflake-0680.lollo-princigalli.workers.dev/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; connect-src 'self' https://shy-snowflake-0680.lollo-princigalli.workers.dev https://www.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'"
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content/index.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "MacCtrl+Shift+Y"
      }
    }
  },
  "action": {
    "default_title": "YT Series",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16_light.png",
      "48": "icons/icon48_light.png",
      "128": "icons/icon128_light.png"
    }
  },
  "icons": {
    "16": "icons/icon16_light.png",
    "48": "icons/icon48_light.png",
    "128": "icons/icon128_light.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "short_name": "YT Series",
  "externally_connectable": {
    "matches": [
      "https://lorenzoprincigalli.github.io/YtSeries/*"
    ]
  }
}
